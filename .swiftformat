# SwiftFormat Configuration for RhoeLiquid
# Consistent code formatting for a professional codebase

# SwiftFormat version
--swiftversion 6.2

# Rules

# Indentation
--indent 4
--indentcase false
--indentstrings false
--tabwidth 4
--smarttabs enabled

# Line breaks
--linebreaks lf
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen same-line
--wrapreturntype preserve
--wrapconditions preserve
--wraptypealiases preserve

# Braces
--allman false
--brace same-line
--elseposition same-line
--guardelse same-line
--xcodeindentation disabled

# Whitespace
--commas always
--decimalgrouping 3,4
--exponentcase lowercase
--exponentgrouping disabled
--fractiongrouping disabled
--hexgrouping 4,8
--hexliteralcase uppercase
--octalgrouping 4,8
--operatorfunc spaced
--ranges spaced
--semicolons never
--stripunusedargs always
--trimwhitespace always
--wrapoperators after

# Code organization
--beforemarks 
--emptybraces no-space
--extensionacl on-declarations
--funcattributes preserve
--ifdef indent
--importgrouping alphabetized
--lineaftermarks true
--marktypes always
--markextensions always
--modifierorder public,private,internal,static,final,class,convenience,required,nonisolated,override,lazy,dynamic
--nospaceoperators ...,..<
--organizetypes class,struct,enum,extension
--redundanttype inferred
--sortedimports enabled
--strongoutlets 
--typeattributes preserve
--varattributes preserve
--voidtype void
--yodaswap always

# Swift 5.7+ features
--acronyms ID,URL,API,HTTP,HTTPS,JSON,XML,YAML,TOML,CSV,SQL,HTML,CSS,JS,WASM,AST,UI,IO
--asynccapture 
--markextensions always
--redundantoptionalinit remove

# Formatting options
--header "//\n//  {file}\n//  {target}\n//\n//  Created as part of RhoeLiquid\n//  A high-performance Swift implementation of the Liquid template language\n//"
--enable blankLinesBetweenScopes
--enable consecutiveBlankLines
--enable consecutiveSpaces
--enable duplicateImports
--enable elseOnSameLine
--enable emptyBraces
--enable enumNamespaces
--enable extensionAccessControl
--enable hoistPatternLet
--enable indent
--enable leadingDelimiters
--enable linebreakAtEndOfFile
--enable markTypes
--enable numberFormatting
--enable preferKeyPath
--enable redundantBackticks
--enable redundantBreak
--enable redundantFileprivate
--enable redundantGet
--enable redundantInit
--enable redundantLet
--enable redundantLetError
--enable redundantNilInit
--enable redundantObjc
--enable redundantParens
--enable redundantPattern
--enable redundantRawValues
--enable redundantReturn
--enable redundantSelf
--enable redundantType
--enable redundantVoidReturnType
--enable semicolons
--enable sortedImports
--enable spaceAroundBraces
--enable spaceAroundBrackets
--enable spaceAroundComments
--enable spaceAroundGenerics
--enable spaceAroundOperators
--enable spaceAroundParens
--enable spaceInsideBraces
--enable spaceInsideBrackets
--enable spaceInsideComments
--enable spaceInsideGenerics
--enable spaceInsideParens
--enable strongOutlets
--enable strongifiedSelf
--enable todos
--enable trailingClosures
--enable trailingCommas
--enable trailingSpace
--enable typeSugar
--enable void
--enable wrapArguments
--enable wrapAttributes
--enable wrapMultilineStatementBraces
--enable yodaConditions

# Disabled rules
--disable andOperator
--disable anyObjectProtocol
--disable assertionFailures
--disable blankLinesAroundMark
--disable blankLinesAtEndOfScope
--disable blankLinesAtStartOfScope
--disable blockComments
--disable conditionalAssignment
--disable isEmpty
--disable redundantClosure
--disable unusedArguments
--disable wrapConditionalBodies
--disable wrapEnumCases
--disable wrapSwitchCases

# Exclude paths
--exclude .build
--exclude .swiftpm
--exclude Tests/*/Fixtures
--exclude Tests/*/Templates
--exclude Documentation
--exclude Scripts
--exclude Benchmarks/Results