{% comment %}
Run:
swift run liquid render Examples/templates/config-audit.html.liquid --context Examples/data/config-audit.json --output Examples/outputs/config-audit.html
{% endcomment %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ audit.name | escape }} configuration audit</title>
  <style>
    body { margin: 0; background: #f7f9f4; color: #18221a; font-family: ui-sans-serif, system-ui, sans-serif; }
    main { max-width: 1080px; margin: 0 auto; padding: 44px 22px; }
    h1 { font-size: clamp(42px, 7vw, 82px); letter-spacing: -.06em; margin-bottom: 8px; }
    .summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 28px 0; }
    .tile, .service { border: 1px solid #d9e1d3; border-radius: 22px; background: white; padding: 20px; box-shadow: 0 12px 34px rgba(24, 34, 26, .06); }
    .tile strong { display: block; font-size: 34px; }
    .service { margin: 14px 0; }
    .service h2 { display: flex; justify-content: space-between; gap: 12px; margin: 0; }
    .risk-low { color: #16744a; }
    .risk-medium { color: #a96700; }
    .risk-high { color: #b42318; }
    code { background: #eef3ea; padding: 3px 6px; border-radius: 6px; }
    @media (max-width: 780px) { .summary { grid-template-columns: 1fr 1fr; } }
  </style>
</head>
<body>
  <main>
    <p>{{ audit.generated_on | escape }}</p>
    <h1>{{ audit.name | escape }}</h1>
    <p>{{ audit.summary | escape }}</p>

    <section class="summary">
      {% for item in summary %}
      <div class="tile">
        <strong>{{ item.value }}</strong>
        <span>{{ item.label | escape }}</span>
      </div>
      {% endfor %}
    </section>

    {% for service in services %}
    <article class="service">
      <h2>
        <span>{{ service.name | escape }}</span>
        <span class="risk-{{ service.risk | downcase }}">{{ service.risk | escape }} risk</span>
      </h2>
      <p>{{ service.description | escape }}</p>
      <h3>Checks</h3>
      <ul>
        {% for check in service.checks %}
        <li>
          <code>{{ check.key | escape }}</code>
          {% if check.passed %}
          passed
          {% else %}
          needs attention: {{ check.note | escape }}
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </article>
    {% endfor %}
  </main>
</body>
</html>
